{
  "name": "vibe-farpost",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n mongo,api,web -c yellow,cyan,green \"npm:db:dev\" \"npm:server:dev\" \"npm:web:dev\"",
    "web:dev": "next dev --hostname 127.0.0.1",
    "server:dev": "tsx watch server/index.ts",
    "server:start": "tsx server/index.ts",
    "db:dev": "node scripts/mongodb.mjs",
    "db:init": "tsx server/scripts/init.ts",
    "typecheck": "next typegen && tsc --noEmit && tsc --project server/tsconfig.json",
    "test:db": "tsx --test tests/database.integration.test.ts",
    "test:ui": "playwright test",
    "build": "next build",
    "start": "concurrently -k -n api,web \"npm:server:start\" \"npm:web:start\"",
    "web:start": "next start --hostname 127.0.0.1",
    "lint": "eslint"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "mongodb": "^6.22.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
